generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum booking_status {
  pending
  driver_assigned
  completed
  cancelled
}

model bookings {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_scheduled        Boolean         @default(false)
  pickup_location     String
  destination         String
  passengers          Int
  customer_name       String
  customer_email      String
  customer_mobile     String
  created_at          DateTime?       @default(now()) @db.Timestamptz(6)
  scheduled_date_time DateTime?       @db.Timestamptz(6)
  pickup_lat          Decimal?        @db.Decimal
  pickup_lng          Decimal?        @db.Decimal
  destination_lat     Decimal?        @db.Decimal
  destination_lng     Decimal?        @db.Decimal
  distance_km         Decimal?        @db.Decimal
  booking_type        String?
  vehicle_type        String?
  status              booking_status?
  driver_id           String?         @db.Uuid
  notes               String?
}

model special_booking_inquiries {
  id           BigInt    @id @default(autoincrement())
  first_name   String?
  last_name    String?
  email        String?
  phone        String?
  company_name String?
  message      String?
  status       String?   @default("New")
  notes        String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
}
