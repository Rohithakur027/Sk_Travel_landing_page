generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model website_booking_enquiries {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enq_ref             String?
  customer_name       String
  customer_email      String
  customer_mobile     String
  pickup_location     String
  destination         String
  pickup_lat          Decimal?  @db.Decimal
  pickup_lng          Decimal?  @db.Decimal
  destination_lat     Decimal?  @db.Decimal
  destination_lng     Decimal?  @db.Decimal
  booking_type        String?
  booking_category    String?
  vehicle_type        String?
  vehicle_label       String?
  passengers          Int
  is_scheduled        Boolean   @default(false)
  pickup_date_time    DateTime? @db.Timestamptz(6)
  is_return_trip      Boolean?  @default(false)
  return_date_time    DateTime? @db.Timestamptz(6)
  distance_km         Decimal?  @db.Decimal
  status              String?   @default("new")
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
}

model website_general_enquiries {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enq_ref      String?
  name         String?
  email        String?
  mobile       String?
  message      String?
  company_name String?
  status       String?   @default("new")
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
}
